# Server
PORT=3000
NODE_ENV=production

# Supabase Postgres
# Use the connection string from Supabase Dashboard > Connect.
# For long-running servers, use the direct string if IPv6 works or the Session pooler if not.
# For serverless hosting, use the Transaction pooler string.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_SSL=require
SUPABASE_DB=true
SKIP_DB_CREATE=true

# Railway Postgres alternative
# If you attach Railway Postgres instead of Supabase, expose one of these variables:
# DATABASE_PRIVATE_URL, DATABASE_PUBLIC_URL, POSTGRES_URL, POSTGRES_PRIVATE_URL, or POSTGRES_PUBLIC_URL.
# PGHOST, PGPORT, PGDATABASE, PGUSER, and PGPASSWORD are also supported.

# Optional local Postgres fallback when DATABASE_URL is not set
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sarisari_pro
DB_USER=postgres
DB_PASSWORD=
DB_ADMIN_DATABASE=postgres

# Pool tuning
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Auth
JWT_SECRET=replace_with_a_48_byte_random_hex_secret
JWT_REFRESH_SECRET=replace_with_a_different_48_byte_random_hex_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Data policy
# true by default. Keep this enabled so the backend stores only summaries.
SUMMARY_ONLY_MODE=true

# Comma-separated web admin origins allowed by CORS.
CORS_ORIGINS=https://your-admin-web-domain.com
